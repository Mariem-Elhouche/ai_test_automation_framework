# Variables pour docker-compose
# Copier ce fichier en .env et remplir les valeurs

# Token de registre généré sur GitHub :
# Settings → Actions → Runners → New runner → copier le token
RUNNER_TOKEN=CHANGE_ME

# URL du dépôt (par défaut celui-ci)
REPO_URL=https://github.com/Mariem-Elhouche/ai_test_automation_framework

# Nom du runner (optionnel, défaut: docker-runner)
RUNNER_NAME=docker-runner
